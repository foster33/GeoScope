{
  "name": "geoscope",
  "version": "1.0.0",
  "description": "Interactive 3D globe area intelligence - draw a radius anywhere on Earth and get a full report on it",
  "license": "AGPL-3.0-or-later",
  "repository": "github:foster33/GeoScope",
  "type": "module",
  "main": "server.js",
  "scripts": {
