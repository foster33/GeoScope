{
  "name": "geoscope",
  "version": "1.0.0",
  "description": "Interactive 3D globe area intelligence - draw a radius anywhere on Earth and get a full report on it",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --import ./fixtures/preload.js server.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
